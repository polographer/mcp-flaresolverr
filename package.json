{
  "name": "mcp-flaresolverr",
  "version": "1.0.0",
  "description": "MCP server that exposes FlareSolverr's anti-bot bypass capabilities via the Model Context Protocol",
  "author": {
    "name": "Marco (Polo) Ornelas",
    "url": "http://poloornelas.mx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polographer/mcp-flaresolverr"
  },
  "type": "module",
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
